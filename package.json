{
  "name": "obsidian-stacks",
  "version": "0.4.1",
  "description": "A research library for your vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.test.mjs && node --test test-dist/*.test.mjs",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "test:e2e:desktop": "E2E_TARGET=desktop wdio run ./wdio.conf.mts",
    "test:e2e:mobile": "E2E_TARGET=mobile wdio run ./wdio.conf.mts",
    "test:e2e:android": "wdio run ./wdio.android.conf.mts",
    "test:e2e:android:deps": "npm install --no-save appium@3.9.0 appium-uiautomator2-driver@8.7.3 @wdio/appium-service@9.33.1",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json",
    "test:e2e:config": "node --import tsx --test test/e2e/*.test.mts",
    "bbt-accuracy": "esbuild scripts/bbt-accuracy.ts --bundle --platform=node --format=esm --outfile=test-dist/bbt-accuracy.mjs --log-level=warning && node test-dist/bbt-accuracy.mjs",
    "lint": "eslint src",
    "check:mobile": "node scripts/check-mobile.mjs",
    "lint:scanner": "eslint -c eslint.scanner.config.mjs ."
  },
  "keywords": [
    "obsidian",
    "zotero",
    "citations",
    "references",
    "bibliography"
  ],
  "author": "Jesse Griffin",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "linkedom": "^0.18.15",
    "obsidian": "^1.8.7",
    "pdfjs-dist": "^4.10.38",
    "tslib": "^2.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0",
    "webdriverio": "^9.33.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "citeproc": "2.4.63"
  }
}
