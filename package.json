{
  "name": "obsidian-library",
  "version": "0.2.0",
  "description": "A reference manager for Obsidian: one note per source, metadata in properties, Bases as the library view.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.test.mjs && node --test test-dist/*.test.mjs",
    "bbt-accuracy": "esbuild scripts/bbt-accuracy.ts --bundle --platform=node --format=esm --outfile=test-dist/bbt-accuracy.mjs --log-level=warning && node test-dist/bbt-accuracy.mjs"
  },
  "keywords": [
    "obsidian",
    "zotero",
    "citations",
    "references",
    "bibliography"
  ],
  "author": "Jesse Griffin",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15",
    "obsidian": "^1.8.7",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5",
    "yaml": "^2.9.1"
  }
}
